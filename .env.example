# Your live site URL (no trailing slash). Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Public contact email shown on the Contact and Privacy pages.
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.com

# --- Google AdSense (leave disabled until Google approves your site) ---
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
# Shows labelled empty boxes where ads will go (useful for layout checks only).
NEXT_PUBLIC_AD_PLACEHOLDERS=false
